# Database
POSTGRES_USER=cloudops
POSTGRES_PASSWORD=cloudops_secret
POSTGRES_DB=cloudops
DATABASE_URL=postgresql://cloudops:cloudops_secret@postgres:5432/cloudops

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
OPERATING_MODE=demo
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Connected AWS mode. Prefer the standard AWS credential chain; do not put
# long-lived access keys in this file. AWS_ROLE_ARN enables STS AssumeRole.
AWS_REGION=us-east-1
AWS_ROLE_ARN=
AWS_EXTERNAL_ID=
AWS_SESSION_NAME=cloudops-platform
AWS_COST_LOOKBACK_DAYS=90

# Connected Kubernetes mode. Empty means in-cluster config first, then the
# current kubeconfig context. Mount kubeconfig separately when using Docker.
KUBERNETES_CONTEXT=

# Optional summary integration (leave empty for deterministic summaries)
OPENAI_API_KEY=

# Frontend
VITE_API_URL=http://localhost:8000
